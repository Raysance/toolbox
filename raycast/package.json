{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "mailcode",
  "title": "InboxCode",
  "description": "Email verification codes, copied automatically.",
  "icon": "icon.png",
  "author": "raysance",
  "license": "MIT",
  "categories": [
    "Productivity",
    "Communication"
  ],
  "platforms": [
    "macOS"
  ],
  "commands": [
    {
      "name": "codes",
      "title": "Verification Codes",
      "description": "View the latest code for each email account",
      "mode": "view",
      "keywords": [
        "otp",
        "code",
        "mail",
        "验证码",
        "inboxcode"
      ]
    },
    {
      "name": "accounts",
      "title": "Manage Accounts",
      "description": "Manage email accounts and automatic copying",
      "mode": "view",
      "keywords": [
        "imap",
        "邮箱",
        "inboxcode"
      ]
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "bundle": "ray bundle",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@raycast/api": "2.14.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.8.0"
  },
  "preferences": [
    {
      "name": "connectionMode",
      "type": "dropdown",
      "title": "Connection",
      "description": "Direct or proxy connection. Changes apply the next time an InboxCode command runs.",
      "required": false,
      "default": "direct",
      "data": [
        {
          "title": "Direct (No Proxy)",
          "value": "direct"
        },
        {
          "title": "System Settings",
          "value": "system"
        },
        {
          "title": "SOCKS5 Proxy",
          "value": "socks5"
        },
        {
          "title": "HTTP Proxy",
          "value": "http"
        }
      ]
    },
    {
      "name": "proxyHost",
      "type": "textfield",
      "title": "Proxy Host",
      "description": "Used only for SOCKS5 or HTTP proxy connections.",
      "required": false,
      "default": "127.0.0.1",
      "placeholder": "127.0.0.1"
    },
    {
      "name": "proxyPort",
      "type": "textfield",
      "title": "Proxy Port",
      "description": "Used only for SOCKS5 or HTTP proxy connections.",
      "required": false,
      "default": "7897",
      "placeholder": "7897"
    }
  ]
}
